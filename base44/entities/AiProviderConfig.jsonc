{
  "name": "AiProviderConfig",
  "type": "object",
  "properties": {
    "qwen_enabled": {
      "type": "boolean",
      "default": false
    },
    "qwen_endpoint": {
      "type": "string",
      "description": "URL base OpenAI-compatible de DashScope (sin /chat/completions). Ej: https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
    },
    "qwen_model": {
      "type": "string",
      "default": "qwen3-vl-plus",
      "description": "Modelo multimodal de Qwen que admite entrada de imagenes. Ej: qwen3-vl-plus, qwen-vl-max."
    },
    "base44_enabled": {
      "type": "boolean",
      "default": true
    },
    "active_seleccion": {
      "type": "string",
      "enum": [
        "qwen",
        "base44",
        "none"
      ],
      "default": "base44"
    },
    "active_ajustes": {
      "type": "string",
      "enum": [
        "qwen",
        "base44",
        "none"
      ],
      "default": "base44"
    }
  },
  "required": [
    "active_seleccion",
    "active_ajustes"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}