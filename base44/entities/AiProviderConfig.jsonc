{
  "name": "AiProviderConfig",
  "type": "object",
  "properties": {
    "qwen_enabled": {
      "type": "boolean",
      "default": false
    },
    "qwen_endpoint": {
      "type": "string",
      "description": "URL base OpenAI-compatible de DashScope (sin /chat/completions). Ej: https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
    },
    "qwen_model": {
      "type": "string",
      "default": "qwen3-vl-plus",
      "description": "Modelo multimodal de Qwen que admite entrada de imagenes. Ej: qwen3-vl-plus, qwen-vl-max."
    },
    "nvidia_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Proveedor experimental NVIDIA (MiniMax M3). No es proveedor por defecto."
    },
    "nvidia_endpoint": {
      "type": "string",
      "default": "https://integrate.api.nvidia.com/v1",
      "description": "URL base OpenAI-compatible de NVIDIA NIM (sin /chat/completions)."
    },
    "nvidia_model": {
      "type": "string",
      "default": "minimaxai/minimax-m3",
      "description": "Modelo VLM de NVIDIA NIM. Ej: minimaxai/minimax-m3."
    },
    "base44_enabled": {
      "type": "boolean",
      "default": true
    },
    "active_seleccion": {
      "type": "string",
      "enum": [
        "qwen",
        "base44",
        "nvidia",
        "none"
      ],
      "default": "base44"
    },
    "active_ajustes": {
      "type": "string",
      "enum": [
        "qwen",
        "base44",
        "nvidia",
        "none"
      ],
      "default": "base44"
    }
  },
  "required": [
    "active_seleccion",
    "active_ajustes"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}