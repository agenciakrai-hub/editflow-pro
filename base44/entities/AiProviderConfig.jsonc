{
  "name": "AiProviderConfig",
  "type": "object",
  "properties": {
    "nvidia_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Proveedor experimental NVIDIA (MiniMax M3). No es proveedor por defecto."
    },
    "nvidia_endpoint": {
      "type": "string",
      "default": "https://integrate.api.nvidia.com/v1",
      "description": "URL base OpenAI-compatible de NVIDIA NIM (sin /chat/completions)."
    },
    "nvidia_model": {
      "type": "string",
      "default": "minimaxai/minimax-m3",
      "description": "Modelo VLM de NVIDIA NIM. Ej: minimaxai/minimax-m3."
    },
    "gemini_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Proveedor Google Gemini (generativelanguage). Enruta previews como data URLs directas, sin UploadFile ni InvokeLLM. Tier gratuito: no consume creditos de integracion Base44."
    },
    "gemini_endpoint": {
      "type": "string",
      "default": "https://generativelanguage.googleapis.com/v1beta",
      "description": "URL base de la API Gemini (sin /models/...)."
    },
    "gemini_model": {
      "type": "string",
      "default": "gemini-3.6-flash",
      "description": "Modelo multimodal de Gemini. Ej: gemini-3.6-flash, gemini-2.5-flash."
    },
    "base44_enabled": {
      "type": "boolean",
      "default": true
    },
    "active_seleccion": {
      "type": "string",
      "enum": [
        "base44",
        "nvidia",
        "gemini",
        "none"
      ],
      "default": "base44"
    },
    "active_ajustes": {
      "type": "string",
      "enum": [
        "base44",
        "nvidia",
        "gemini",
        "none"
      ],
      "default": "base44"
    }
  },
  "required": [
    "active_seleccion",
    "active_ajustes"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}