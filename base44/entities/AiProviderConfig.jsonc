{
  "name": "AiProviderConfig",
  "type": "object",
  "properties": {
    "qwen_enabled": {
      "type": "boolean",
      "default": false
    },
    "qwen_endpoint": {
      "type": "string",
      "description": "URL base OpenAI-compatible de DashScope (sin /chat/completions). Ej: https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
    },
    "qwen_model": {
      "type": "string",
      "default": "qwen3-vl-plus",
      "description": "Modelo multimodal de Qwen que admite entrada de imagenes. Ej: qwen3-vl-plus, qwen-vl-max."
    },
    "nvidia_enabled": {
      "type": "boolean",
      "default": false
    },
    "nvidia_endpoint": {
      "type": "string",
      "default": "https://integrate.api.nvidia.com/v1",
      "description": "URL base OpenAI-compatible de NVIDIA NIM (sin /chat/completions)."
    },
    "nvidia_model": {
      "type": "string",
      "default": "minimaxai/minimax-m3",
      "description": "Modelo VLM de NVIDIA NIM. Ej: minimaxai/minimax-m3."
    },
    "gemini_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Proveedor Google Gemini (generativelanguage). Enruta previews como data URLs directas, sin UploadFile ni InvokeLLM."
    },
    "gemini_endpoint": {
      "type": "string",
      "default": "https://generativelanguage.googleapis.com/v1beta",
      "description": "URL base de la API Gemini (sin /models/...)."
    },
    "gemini_model": {
      "type": "string",
      "default": "gemini-2.5-flash",
      "description": "Modelo multimodal de Gemini. \u00danico modelo admitido: gemini-2.5-flash."
    },
    "base44_enabled": {
      "type": "boolean",
      "default": true
    },
    "active_seleccion": {
      "type": "string",
      "default": "base44",
      "description": "Proveedor activo para Seleccion IA. Uno de: base44, none, o custom:<id> para un proveedor de la base de datos."
    },
    "active_ajustes": {
      "type": "string",
      "default": "base44",
      "description": "Proveedor activo para Ajustes IA. Uno de: custom:<id>, o valores legados (base44, qwen, nvidia, gemini, none)."
    },
    "active_model_seleccion": {
      "type": "string",
      "description": "Modelo EXACTO para Selecci\u00f3n IA dentro del proveedor activo (custom:<id>): los motores lo usan SIEMPRE, sin heur\u00edstica. Debe pertenecer a la lista marcada (seleccion_models) del proveedor activo. Vac\u00edo = autom\u00e1tico (mejor modelo marcado)."
    },
    "active_model_ajustes": {
      "type": "string",
      "description": "Modelo EXACTO para Ajustes IA (IA Visual e H\u00edbrido) dentro del proveedor activo (custom:<id>): ambos modos lo usan SIEMPRE, sin heur\u00edstica ni sustituciones. Debe pertenecer a la lista marcada (ajustes_models) del proveedor activo. Vac\u00edo = autom\u00e1tico (mejor modelo marcado)."
    },
    "builtin_migrated": {
      "type": "boolean",
      "default": false,
      "description": "true tras migrar los proveedores integrados (Gemini/Qwen/NVIDIA) a filas de CustomAiProvider. Evita recrearlos si el administrador los borra."
    }
  },
  "required": [
    "active_seleccion",
    "active_ajustes"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}