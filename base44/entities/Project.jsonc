{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "selection",
        "editing",
        "exporting",
        "completed"
      ],
      "default": "draft"
    },
    "photo_count": {
      "type": "number",
      "default": 0
    },
    "selected_count": {
      "type": "number",
      "default": 0
    },
    "edited_count": {
      "type": "number",
      "default": 0
    },
    "cover_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "photos_metadata": {
      "type": "array",
      "description": "Metadatos por foto (sin previews ni RAW): filename, estado de selecci\u00f3n, rating, label y si se edit\u00f3.",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "TOP_PICK / SELECT / REVIEW / REJECT"
          },
          "rating": {
            "type": "number",
            "default": 0
          },
          "color_label": {
            "type": "string"
          },
          "edit_applied": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}