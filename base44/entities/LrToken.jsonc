{
  "name": "LrToken",
  "type": "object",
  "properties": {
    "token": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "token",
    "user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}