{
  "name": "Photo",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "culling_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "selected",
        "rejected",
        "maybe"
      ],
      "default": "unreviewed"
    },
    "star_rating": {
      "type": "number",
      "default": 0
    },
    "color_label": {
      "type": "string",
      "enum": [
        "none",
        "red",
        "yellow",
        "green",
        "blue",
        "purple"
      ],
      "default": "none"
    },
    "edit_applied": {
      "type": "boolean",
      "default": false
    },
    "preset_id": {
      "type": "string"
    },
    "adjustments": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "exposure": {
          "type": "number"
        },
        "contrast": {
          "type": "number"
        },
        "highlights": {
          "type": "number"
        },
        "shadows": {
          "type": "number"
        },
        "whites": {
          "type": "number"
        },
        "blacks": {
          "type": "number"
        },
        "temperature": {
          "type": "number"
        },
        "tint": {
          "type": "number"
        },
        "vibrance": {
          "type": "number"
        },
        "saturation": {
          "type": "number"
        },
        "texture": {
          "type": "number"
        },
        "clarity": {
          "type": "number"
        },
        "dehaze": {
          "type": "number"
        },
        "sharpness": {
          "type": "number"
        },
        "sharpRadius": {
          "type": "number"
        },
        "sharpDetail": {
          "type": "number"
        },
        "sharpMasking": {
          "type": "number"
        },
        "noiseLuminance": {
          "type": "number"
        },
        "noiseLumDetail": {
          "type": "number"
        },
        "noiseContrast": {
          "type": "number"
        },
        "colorNoise": {
          "type": "number"
        },
        "colorDetail": {
          "type": "number"
        },
        "colorSmoothness": {
          "type": "number"
        },
        "distortion": {
          "type": "number"
        },
        "chromaticAb": {
          "type": "number"
        },
        "defringePurple": {
          "type": "number"
        },
        "defringeGreen": {
          "type": "number"
        },
        "lensVignette": {
          "type": "number"
        },
        "lensVignetteMid": {
          "type": "number"
        },
        "transformVertical": {
          "type": "number"
        },
        "transformHorizontal": {
          "type": "number"
        },
        "transformRotate": {
          "type": "number"
        },
        "transformScale": {
          "type": "number"
        },
        "transformAspect": {
          "type": "number"
        },
        "transformOffsetX": {
          "type": "number"
        },
        "transformOffsetY": {
          "type": "number"
        },
        "pcvAmount": {
          "type": "number"
        },
        "pcvMidpoint": {
          "type": "number"
        },
        "pcvRoundness": {
          "type": "number"
        },
        "pcvFeather": {
          "type": "number"
        },
        "pcvHighlights": {
          "type": "number"
        },
        "grainAmount": {
          "type": "number"
        },
        "grainSize": {
          "type": "number"
        },
        "grainRoughness": {
          "type": "number"
        },
        "shadowTint": {
          "type": "number"
        },
        "redHue": {
          "type": "number"
        },
        "redSaturation": {
          "type": "number"
        },
        "greenHue": {
          "type": "number"
        },
        "greenSaturation": {
          "type": "number"
        },
        "blueHue": {
          "type": "number"
        },
        "blueSaturation": {
          "type": "number"
        },
        "cameraProfile": {
          "type": "string"
        },
        "curve": {
          "type": "object",
          "additionalProperties": true
        },
        "hsl": {
          "type": "object",
          "additionalProperties": true
        },
        "grading": {
          "type": "object",
          "additionalProperties": true
        },
        "crop": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "export_status": {
      "type": "string",
      "enum": [
        "pending",
        "exported",
        "failed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "project_id",
    "file_url"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}