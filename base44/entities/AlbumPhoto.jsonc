{
  "name": "AlbumPhoto",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Referencia al AlbumProject."
    },
    "filename": {
      "type": "string"
    },
    "relative_path": {
      "type": "string",
      "description": "Ruta relativa dentro de la carpeta importada."
    },
    "orientation": {
      "type": "string",
      "enum": [
        "landscape",
        "portrait",
        "square"
      ],
      "default": "landscape",
      "description": "Derivada de las dimensiones reales del archivo."
    },
    "capture_time": {
      "type": "number",
      "description": "Epoch ms (para orden temporal y futura narrativa IA)."
    },
    "preview_status": {
      "type": "string",
      "enum": [
        "ok",
        "missing",
        "unlinked"
      ],
      "default": "ok",
      "description": "ok = preview disponible / \u00faltimo enlace correcto; missing = preview no disponible en este dispositivo; unlinked = se confirm\u00f3 que el archivo original no est\u00e1 (el spread conserva su geometr\u00eda)."
    },
    "file_size": {
      "type": "number",
      "description": "Fase 3.1 \u2014 identidad L1: tama\u00f1o del archivo original en bytes. Opcional (fotos v1 no lo tienen)."
    },
    "content_hash": {
      "type": "string",
      "description": "Fase 3.1 \u2014 identidad L2: SHA-256 exacto del archivo, calculado en el navegador. Opcional."
    },
    "phash": {
      "type": "string",
      "description": "Fase 3.1 \u2014 identidad L3: hash perceptual de 64 bits de la preview (para re-localizaci\u00f3n difusa con confirmaci\u00f3n manual). Opcional."
    },
    "width_px": {
      "type": "number",
      "description": "Fase 3.1 \u2014 identidad L4: anchura real de la imagen en p\u00edxeles. Opcional."
    },
    "height_px": {
      "type": "number",
      "description": "Fase 3.1 \u2014 identidad L4: altura real de la imagen en p\u00edxeles. Opcional."
    },
    "ai_state": {
      "type": "string",
      "enum": [
        "recommended",
        "considered",
        "discarded",
        "unreviewed"
      ],
      "default": "unreviewed",
      "description": "Nivel IA (fase futura). El fot\u00f3grafo puede usar cualquier foto siempre."
    },
    "ai_rank": {
      "type": "number",
      "description": "Reserva fase IA."
    },
    "ai_scores": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reserva fase IA (nitidez, expresi\u00f3n, etc.)."
    },
    "ai_category": {
      "type": "string",
      "description": "Reserva fase IA (categor\u00eda narrativa)."
    }
  },
  "required": [
    "project_id",
    "filename"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}